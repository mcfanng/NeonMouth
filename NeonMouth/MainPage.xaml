<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NeonMouth.ViewModels"
             x:Class="NeonMouth.MainPage"
             x:DataType="vm:MainViewModel"
             Title="NeonMouth">

    <Shell.TitleView>
        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
            <Image Source="neonmouth_logo.png" HeightRequest="32" VerticalOptions="Center" />
            <Label Text="NeonMouth" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
        </HorizontalStackLayout>
    </Shell.TitleView>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="16">

                <Border Padding="14" StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Devices" FontAttributes="Bold" FontSize="16" />
                        <Label Text="Input" FontSize="12" />
                        <Picker ItemsSource="{Binding InputNames}" SelectedIndex="{Binding SelectedInputIndex}" />
                        <Label Text="Auto-selected" FontSize="12" TextColor="{StaticResource Gray500}"
                               IsVisible="{Binding InputAutoSelected}" />
                        <Label Text="Output" FontSize="12" />
                        <Picker x:Name="OutputPicker" ItemsSource="{Binding OutputNames}"
                                SelectedIndex="{Binding SelectedOutputIndex, Mode=OneWay}"
                                SelectedIndexChanged="OnOutputPickerChanged" />
                        <Label Text="Auto-selected" FontSize="12" TextColor="{StaticResource Gray500}"
                               IsVisible="{Binding OutputAutoSelected}" />
                        <Label Text="✓ Recommended: phone mic + wired headphones (lowest latency)."
                               FontSize="12" TextColor="{AppThemeBinding Light={StaticResource AccentOnLight}, Dark={StaticResource Accent}}" IsVisible="{Binding IsRecommendedSetup}" />
                        <Button Text="Rescan" Command="{Binding RescanCommand}" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Border>

                <!-- Non-blocking "new device — switch?" prompt (§2.5). -->
                <Border Padding="14" StrokeShape="RoundRectangle 10" IsVisible="{Binding HasPendingDevice}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding PendingDeviceText}" />
                        <HorizontalStackLayout Spacing="8">
                            <Button Text="Switch" Command="{Binding AcceptPendingDeviceCommand}" />
                            <Button Text="Dismiss" Command="{Binding DismissPendingDeviceCommand}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding PairingProblem}" IsVisible="{Binding HasPairingProblem}"
                       TextColor="OrangeRed" FontAttributes="Bold" />

                <!-- Call-quality advice for a Bluetooth device's own mic. -->
                <Border Padding="14" StrokeShape="RoundRectangle 10" IsVisible="{Binding HasPairingWarning}">
                    <Label Text="{Binding PairingWarning}" />
                </Border>

                <Label Text="{Binding BlockingMessage}"
                       IsVisible="{Binding HasBlockingMessage}"
                       TextColor="OrangeRed" FontAttributes="Bold" />

                <VerticalStackLayout Spacing="6">
                    <Label Text="Voice effect" FontAttributes="Bold" />
                    <Picker ItemsSource="{Binding Effects}" SelectedIndex="{Binding SelectedEffectIndex}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding Intensity, StringFormat='Effect intensity: {0:P0}'}" />
                    <Slider Minimum="0" Maximum="1" Value="{Binding Intensity}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding OutputGain, StringFormat='Output gain ceiling: {0:P0}'}" />
                    <Slider Minimum="0" Maximum="1" Value="{Binding OutputGain}" />
                    <Label Text="A hard limiter always caps the output level, whatever this is set to."
                           FontSize="12" TextColor="{StaticResource Gray500}" />
                </VerticalStackLayout>

                <!-- Feedback protection toggle (§3.2, §4.1). -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label Text="Feedback protection" />
                        <Label Text="Cuts the pitch of a howl when the speaker is too close to the mic."
                               FontSize="12" TextColor="{StaticResource Gray500}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding FeedbackProtection}" VerticalOptions="Center" />
                </Grid>

                <Button Text="{Binding StartStopText}" Command="{Binding ToggleCommand}"
                        FontSize="20" HeightRequest="60" />

                <Label Text="{Binding StatusText}" HorizontalOptions="Center" />

                <Label Text="⚠ Feedback detected and reduced. Move the speaker away from the mic or turn it down."
                       IsVisible="{Binding FeedbackProtectionActive}" TextColor="OrangeRed" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />

                <VerticalStackLayout Spacing="4">
                    <Label Text="Mic level" FontSize="12" />
                    <ProgressBar Progress="{Binding InputLevel}" />
                    <Label Text="Output level" FontSize="12" />
                    <ProgressBar Progress="{Binding OutputLevel}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- In-app microphone disclosure (§6.3), shown until accepted. -->
        <Grid IsVisible="{Binding ShowDisclosure}" BackgroundColor="#CC000000">
            <Border Margin="24" Padding="20" VerticalOptions="Center" StrokeShape="RoundRectangle 12"
                    BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="How the microphone is used" FontSize="18" FontAttributes="Bold" />
                    <Label Text="NeonMouth uses your microphone only to change your voice in real time and play it through your headphones or speaker. Audio is never recorded, stored, or sent over the network. It keeps running with the screen off after you press Start, until you press Stop." />
                    <Button Text="Got it" Command="{Binding AcceptDisclosureCommand}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
